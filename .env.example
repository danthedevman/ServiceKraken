# Docker defaults work without this file. Preserve existing .env values during upgrades.
APP_PORT=8090
APP_ORIGIN=http://127.0.0.1:8090
COOKIE_SECURE=false
MONGODB_DB=servicekraken
# Local Node services use localhost unless these are set.
# MONGODB_URI=mongodb://127.0.0.1:27017
# REDIS_URL=redis://127.0.0.1:6379
SCHEDULER_INTERVAL_MS=1000
CHECK_CONCURRENCY=10
# Docker generates and shares its encryption key automatically.
# For local API/workers, set one shared absolute key path.
# INTEGRATION_KEY_FILE=/absolute/path/to/servicekraken/.servicekraken/integration.key
# Optional existing-key override; must match the saved key.
INTEGRATION_ENCRYPTION_KEY=
# Existing storage can be reused with these optional volume-name overrides.
# MONGO_VOLUME_NAME=
# REDIS_VOLUME_NAME=
# INTEGRATION_KEYS_VOLUME_NAME=

# Deployment storage backend: mongodb (default) or postgres. Redis is still required.
DATABASE_PROVIDER=mongodb
# Optional MongoDB URI or required PostgreSQL connection URL. Never commit real credentials.
DATABASE_URL=
DATABASE_SCHEMA=servicekraken
DATABASE_SSL=false
# PostgreSQL custom CA file, mounted read-only into API, workers, and scheduler.
DATABASE_CA_FILE=
# For compose.postgres.yaml, also set these and DATABASE_URL using the same credentials:
# POSTGRES_DB=servicekraken
# POSTGRES_USER=servicekraken
# POSTGRES_PASSWORD=replace-with-a-long-random-password
# DATABASE_URL=postgresql://servicekraken:URL_ENCODED_PASSWORD@postgres:5432/servicekraken
